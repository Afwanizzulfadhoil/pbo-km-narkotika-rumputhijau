<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" xmlns:fx="http://javafx.com/fxml/1"
         xmlns="http://javafx.com/javafx/17" fx:controller="rumputhijau.pbokmnarkotikarumputhijau.view.JavaFXController">
    <tabs>

        <!-- TAB 1: DAFTAR PUTUSAN -->
        <Tab fx:id="tabDaftar" text="📋 Daftar Putusan">
            <VBox spacing="15" style="-fx-background-color: #FFFFFF;">
                <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

                <VBox spacing="5">
                    <Label text="DAFTAR PUTUSAN HUKUM" style="-fx-font-weight: 800; -fx-font-size: 18px; -fx-text-fill: #1E293B; -fx-letter-spacing: 1px;"/>
                    <Label text="Sistem Informasi Rekam Data Kasus Narkotika" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                </VBox>

                <TableView fx:id="tablePutusan" VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #E2E8F0; -fx-overflow-changed: transparent;">
                    <columns>
                        <TableColumn fx:id="colNoPerkara" text="No. Perkara" prefWidth="160"/>
                        <TableColumn fx:id="colPengadilan" text="Pengadilan" prefWidth="170"/>
                        <TableColumn fx:id="colTahunPerkara" text="Tahun Perkara" prefWidth="105" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colNamaTerdakwa" text="Nama Terdakwa" prefWidth="190"/>
                        <TableColumn fx:id="colUmur" text="Umur" prefWidth="70" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colPeran" text="Peran" prefWidth="160"/>
                        <TableColumn fx:id="colJenisNarkotika" text="Jenis Narkotika" prefWidth="130"/>
                        <TableColumn fx:id="colBeratBB" text="Berat Barang Bukti" prefWidth="140"/>
                        <TableColumn fx:id="colPasal" text="Pasal" prefWidth="220"/>
                        <TableColumn fx:id="colVonis" text="Vonis Hukuman" prefWidth="105" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colDenda" text="Vonis Denda" prefWidth="140" style="-fx-alignment: CENTER_RIGHT;"/>
                        <TableColumn fx:id="colNamaHakim" text="Nama Hakim" prefWidth="170"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #F1F5F9; -fx-padding: 10px; -fx-background-radius: 6px;">
                    <Label fx:id="lblJumlahData" text="Jumlah data: 0 putusan." style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Edit Terpilih" onAction="#handleEditTerpilih"
                            style="-fx-background-color: #0284C7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7px 14px; -fx-background-radius: 6px; -fx-cursor: hand;"/>
                    <Button text="Delete Terpilih" onAction="#handleHapusPutusan"
                            style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7px 14px; -fx-background-radius: 6px; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- TAB 2: DETAIL & CARI -->
        <Tab fx:id="tabDetail" text="🔍 Detail Putusan">
            <VBox spacing="20" style="-fx-background-color: #FFFFFF;">
                <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

                <VBox spacing="5">
                    <Label text="PENCARIAN &amp; DETAIL KASUS" style="-fx-font-weight: 800; -fx-font-size: 18px; -fx-text-fill: #1E293B;"/>
                    <Label text="Cari berdasarkan nomor perkara resmi untuk melihat rincian vonis" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                </VBox>

                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #F8F9FA; -fx-padding: 15px; -fx-background-radius: 8px; -fx-border-color: #E2E8F0; -fx-border-radius: 8px;">
                    <TextField fx:id="txtCariNoPerkara" promptText="Masukkan No. Perkara (contoh: 123/Pid.Sus/...)" prefWidth="350.0"
                               style="-fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-color: #FFFFFF;"/>
                    <Button text="Cari Detail Kasus" onAction="#handleCariPutusan" mouseTransparent="false"
                            style="-fx-background-color: #0284C7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 16px; -fx-background-radius: 6px; -fx-cursor: hand;"/>
                </HBox>

                <!-- Card Detail Box -->
                <VBox spacing="15" style="-fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-color: #F8F9FA; -fx-background-radius: 8px;" VBox.vgrow="ALWAYS">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <Label text="Rincian Berkas Putusan" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #475569;"/>
                    <Separator style="-fx-background-color: #E2E8F0;"/>

                    <GridPane vgap="14" hgap="20">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150" prefWidth="180" maxWidth="200" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <Label text="Nomor Perkara:" style="-fx-text-fill: #64748B; -fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetailNoPerkara" text="-" style="-fx-text-fill: #0F172A; -fx-font-weight: bold; -fx-font-size: 14px;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Nama Terdakwa:" style="-fx-text-fill: #64748B;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetailTerdakwa" text="-" style="-fx-text-fill: #334155;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Jenis Narkotika:" style="-fx-text-fill: #64748B;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetailNarkotika" text="-" style="-fx-text-fill: #334155;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Vonis Hukuman:" style="-fx-text-fill: #64748B;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetailVonis" text="-" style="-fx-text-fill: #E11D48; -fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Vonis Denda:" style="-fx-text-fill: #64748B;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetailDenda" text="-" style="-fx-text-fill: #059669; -fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Pasal:" style="-fx-text-fill: #64748B;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetailPasal" text="-" wrapText="true" style="-fx-text-fill: #334155;" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Nama Hakim:" style="-fx-text-fill: #64748B;" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetailHakim" text="-" wrapText="true" style="-fx-text-fill: #334155;" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                        <Label text="Peran:" style="-fx-text-fill: #64748B;" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetailPeran" text="-" wrapText="true" style="-fx-text-fill: #334155;" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                        <Label text="Berat Barang Bukti:" style="-fx-text-fill: #64748B;" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetailBeratBB" text="-" style="-fx-text-fill: #334155;" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                        <Label text="Pengadilan:" style="-fx-text-fill: #64748B;" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetailPengadilan" text="-" wrapText="true" style="-fx-text-fill: #334155;" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                        <Label text="Tahun Perkara:" style="-fx-text-fill: #64748B;" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetailTahun" text="-" style="-fx-text-fill: #334155;" GridPane.rowIndex="10" GridPane.columnIndex="1"/>

                        <Label text="Umur:" style="-fx-text-fill: #64748B;" GridPane.rowIndex="11" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetailUmur" text="-" style="-fx-text-fill: #334155;" GridPane.rowIndex="11" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </VBox>
        </Tab>

        <!-- TAB 3: STATISTIK -->
        <Tab fx:id="tabStatistik" text="📊 Statistik">
            <VBox spacing="20" style="-fx-background-color: #FFFFFF;">
                <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

                <VBox spacing="5">
                    <Label text="STATISTIK PUTUSAN NARKOTIKA" style="-fx-font-weight: 800; -fx-font-size: 18px; -fx-text-fill: #1E293B;"/>
                    <Label text="Metrik data agregat dari keputusan sidang panel hakim" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                </VBox>

                <VBox spacing="15" style="-fx-background-color: #F8F9FA; -fx-padding: 20px; -fx-background-radius: 8px; -fx-border-color: #E2E8F0; -fx-border-radius: 8px;">
                    <Label fx:id="lblTotalDataset" text="Data statistik belum tersedia!" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Separator/>
                    <Label fx:id="lblKategoriVonis" text="" style="-fx-line-spacing: 6px; -fx-text-fill: #475569; -fx-font-size: 13px;"/>
                </VBox>
            </VBox>
        </Tab>

        <!-- TAB 4: TAMBAH DATA -->
        <Tab fx:id="tabInput" text="➕ Tambah Data">
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #FFFFFF;">
                <VBox spacing="20">
                    <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

                    <VBox spacing="5">
                        <Label text="INPUT DATA PUTUSAN BARU" style="-fx-font-weight: 800; -fx-font-size: 18px; -fx-text-fill: #1E293B;"/>
                        <Label text="Pastikan semua kolom informasi hukum terisi dengan valid sebelum disimpan" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                    </VBox>

                    <Separator/>

                    <GridPane vgap="12" hgap="15">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150" prefWidth="160" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
                        </columnConstraints>

                        <Label text="Nomor Perkara:" style="-fx-text-fill: #475569;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfNoPerkara" style="-fx-background-radius: 4px; -fx-padding: 6px;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Pengadilan:" style="-fx-text-fill: #475569;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfPengadilan" style="-fx-background-radius: 4px; -fx-padding: 6px;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Tahun Perkara:" style="-fx-text-fill: #475569;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfTglPutusan" style="-fx-background-radius: 4px; -fx-padding: 6px;" promptText="Contoh: 2024" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Nama Terdakwa:" style="-fx-text-fill: #475569;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfNamaTerdakwa" style="-fx-background-radius: 4px; -fx-padding: 6px;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Umur Terdakwa:" style="-fx-text-fill: #475569;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfUmur" style="-fx-background-radius: 4px; -fx-padding: 6px;" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Jenis Narkotika:" style="-fx-text-fill: #475569;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfJenisNarkotika" style="-fx-background-radius: 4px; -fx-padding: 6px;" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Berat Barang Bukti:" style="-fx-text-fill: #475569;" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfBeratBB" style="-fx-background-radius: 4px; -fx-padding: 6px;" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                        <Label text="Pasal Dilanggar:" style="-fx-text-fill: #475569;" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfPasal" style="-fx-background-radius: 4px; -fx-padding: 6px;" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                        <Label text="Peran Terdakwa:" style="-fx-text-fill: #475569;" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfPeran" style="-fx-background-radius: 4px; -fx-padding: 6px;" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                        <Label text="Vonis Hukuman (Tahun):" style="-fx-text-fill: #475569;" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfVonisHukuman" style="-fx-background-radius: 4px; -fx-padding: 6px;" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                        <Label text="Vonis Denda:" style="-fx-text-fill: #475569;" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfVonisDenda" style="-fx-background-radius: 4px; -fx-padding: 6px;" GridPane.rowIndex="10" GridPane.columnIndex="1"/>

                        <Label text="Nama Hakim:" style="-fx-text-fill: #475569;" GridPane.rowIndex="11" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfNamaHakim" style="-fx-background-radius: 4px; -fx-padding: 6px;" GridPane.rowIndex="11" GridPane.columnIndex="1"/>
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10px 0 0 0;">
                        <Button text="💾 Simpan Data Putusan" onAction="#handleSimpanPutusan"
                                prefWidth="200.0"
                                style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 6px; -fx-cursor: hand; -fx-font-size: 13px;"/>
                        <Button text="Update Putusan" onAction="#handleUpdatePutusan"
                                prefWidth="160.0"
                                style="-fx-background-color: #D97706; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 6px; -fx-cursor: hand; -fx-font-size: 13px;"/>
                        <Button text="Delete Putusan" onAction="#handleHapusPutusan"
                                prefWidth="160.0"
                                style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 6px; -fx-cursor: hand; -fx-font-size: 13px;"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </Tab>

    </tabs>
</TabPane>
